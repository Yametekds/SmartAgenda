@page "/"
@implements IDisposable
@using System.Globalization
@inject TareaStorageService Storage
@inject GoogleCalendarService GoogleCalendar
@inject LocalizationService L
@inject NavigationManager Navigation

<PageTitle>Smart Agenda</PageTitle>

<div class="portada">
    <p class="portada-fecha">@HoyLargo</p>
    <h1 class="portada-titulo">@L.T("hero.tituloPrefijo") <em>@L.T("hero.tituloAcento")</em></h1>
    <p class="portada-sub">@L.T("hero.subtitulo")</p>
</div>

<Compositor SemanaInicio="semanaActual" OnEventos="MostrarVistaPrevia" OnMensaje="m => mensajeEstado = m" />

@if (!string.IsNullOrEmpty(mensajeEstado))
{
    <p class="estado" role="status" @key="mensajeEstado">
        <span class="estado-texto">@mensajeEstado</span>
        <button class="btn-icono btn-icono-sm" type="button" aria-label="@L.T("boton.cerrar")" title="@L.T("boton.cerrar")" @onclick="() => mensajeEstado = null">
            <Icono Nombre="cerrar" Tamano="14" />
        </button>
    </p>
}

@if (eventosPendientes.Count > 0)
{
    <VistaPrevia Eventos="eventosPendientes" Confirmando="confirmando"
                 OnConfirmar="ConfirmarEventosPendientes" OnCancelar="() => eventosPendientes.Clear()"
                 OnQuitar="ev => eventosPendientes.Remove(ev)" />
}

<BarraGoogle Conectando="conectando" Importando="sincronizandoDesdeGoogle"
             OnConectar="ConectarGoogle" OnImportar="SincronizarDesdeGoogle" OnDesconectar="DesconectarGoogle" />

<CabeceraSemana Lunes="semanaActual" Nombre="@nombreSemana" EsSemanaActual="@(semanaActual == LunesDeHoy())"
                OnAnterior="() => IrASemanaAsync(semanaActual.AddDays(-7))"
                OnSiguiente="() => IrASemanaAsync(semanaActual.AddDays(7))"
                OnHoy="() => IrASemanaAsync(LunesDeHoy())"
                OnRenombrar="RenombrarSemana" />

@* La clave por semana hace que al cambiar de semana se monte una rejilla nueva y entre con su
   propia transición (hacia la izquierda o la derecha según el sentido del cambio). *@
<div class="semana" @key="semanaActual" data-sentido="@sentido">
    @foreach (var (fecha, i) in DiasSemana.Select((f, i) => (f, i)))
    {
        <ColumnaDia @key="fecha" Fecha="fecha" Orden="i" EsHoy="@(fecha == Hoy)"
                    Tareas="@(semana.TryGetValue(fecha, out var tareas) ? tareas : SinTareas)"
                    GoogleConectado="GoogleCalendar.EstaConectado"
                    OnAlternar="t => AlternarCompletada(fecha, t)"
                    OnGuardar="e => GuardarEdicion(fecha, e)"
                    OnEliminar="t => EliminarTarea(fecha, t)"
                    OnSincronizar="t => SincronizarTarea(fecha, t)" />
    }
</div>

@code {
    private static readonly List<TareaItem> SinTareas = new();

    private string? mensajeEstado;
    private bool conectando;
    private bool sincronizandoDesdeGoogle;
    private bool confirmando;

    private List<EventoPropuesto> eventosPendientes = new();

    private DateOnly semanaActual;
    private string sentido = "ninguno";
    private string? nombreSemana;
    private Dictionary<DateOnly, List<TareaItem>> semana = new();

    private static DateOnly Hoy => DateOnly.FromDateTime(DateTime.Now);

    private IEnumerable<DateOnly> DiasSemana => Enumerable.Range(0, 7).Select(i => semanaActual.AddDays(i));

    private string HoyLargo
    {
        get
        {
            var texto = DateTime.Now.ToString(L.Actual == Idioma.En ? "dddd, MMMM d" : "dddd d 'de' MMMM", CultureInfo.GetCultureInfo(L.CodigoCultura));
            return texto.Length == 0 ? texto : char.ToUpper(texto[0], CultureInfo.InvariantCulture) + texto[1..];
        }
    }

    protected override async Task OnInitializedAsync()
    {
        L.OnCambio += AlCambiarIdioma;

        // Vuelta del inicio de sesión de Google (ver /google/callback en Program.cs).
        var consulta = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (consulta.TryGetValue("google", out var resultadoGoogle))
        {
            mensajeEstado = resultadoGoogle == "ok" ? L.T("mensaje.conectadoGoogle") : L.T("mensaje.errorConectarGoogleRedireccion");
        }

        semanaActual = LunesDeHoy();
        await CargarSemanaAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Quita el "?google=..." de la dirección para que el aviso no reaparezca al recargar.
        if (firstRender && Navigation.Uri.Contains("google="))
        {
            Navigation.NavigateTo("/", replace: true);
        }
    }

    private void AlCambiarIdioma() => InvokeAsync(StateHasChanged);

    private async Task CargarSemanaAsync()
    {
        semana = await Storage.ObtenerSemanaAsync(semanaActual);
        nombreSemana = await Storage.ObtenerNombreSemanaAsync(semanaActual);
    }

    /// <summary>
    /// Carga primero los datos de la semana de destino y solo después la muestra, para que la
    /// rejilla nueva entre ya con sus tareas (sin un parpadeo intermedio con las de la anterior).
    /// </summary>
    private async Task IrASemanaAsync(DateOnly lunes)
    {
        if (lunes == semanaActual) return;

        var datos = await Storage.ObtenerSemanaAsync(lunes);
        var nombre = await Storage.ObtenerNombreSemanaAsync(lunes);

        sentido = lunes > semanaActual ? "adelante" : "atras";
        semanaActual = lunes;
        semana = datos;
        nombreSemana = nombre;
    }

    private static DateOnly LunesDeHoy() => LunesDe(Hoy);

    private static DateOnly LunesDe(DateOnly fecha)
    {
        var diferencia = ((int)fecha.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7;
        return fecha.AddDays(-diferencia);
    }

    private async Task RenombrarSemana(string nombre)
    {
        await Storage.GuardarNombreSemanaAsync(semanaActual, nombre);
        nombreSemana = string.IsNullOrWhiteSpace(nombre) ? null : nombre.Trim();
    }

    private void MostrarVistaPrevia(List<EventoPropuesto> eventos) => eventosPendientes = eventos;

    /// <summary>Guarda localmente y sincroniza con Google Calendar cada evento ya revisado por el usuario.</summary>
    private async Task ConfirmarEventosPendientes()
    {
        if (eventosPendientes.Count == 0) return;

        confirmando = true;
        try
        {
            var creadas = 0;
            var sincronizadas = 0;
            var sinSincronizar = new List<string>();
            DateOnly? primeraFecha = null;

            foreach (var ev in eventosPendientes.ToList())
            {
                var tarea = new TareaItem
                {
                    Texto = ev.Texto,
                    Hora = ev.Hora,
                    Duracion = ev.Duracion,
                    Fecha = ev.Fecha
                };

                await Storage.AgregarTareaAsync(ev.Fecha, tarea);
                creadas++;
                primeraFecha ??= ev.Fecha;

                if (GoogleCalendar.EstaConectado)
                {
                    try
                    {
                        tarea.GoogleEventId = await GoogleCalendar.CrearOActualizarEventoAsync(tarea, ev.Fecha);
                        await Storage.ActualizarTareaAsync(ev.Fecha, tarea);
                        sincronizadas++;
                    }
                    catch
                    {
                        // Se avisa en el resumen final; no se interrumpe la creación del resto. La
                        // tarea queda guardada en local y se puede reenviar con su botón de sincronizar.
                        sinSincronizar.Add(tarea.Texto);
                    }
                }
            }

            eventosPendientes.Clear();

            if (primeraFecha is { } f && (f < semanaActual || f > semanaActual.AddDays(6)))
            {
                await IrASemanaAsync(LunesDe(f));
            }
            else
            {
                await CargarSemanaAsync();
            }

            mensajeEstado = GoogleCalendar.EstaConectado
                ? L.T("mensaje.eventosCreadosConGoogle", creadas, sincronizadas)
                : L.T("mensaje.eventosCreadosSinGoogle", creadas);
            if (sinSincronizar.Count > 0)
            {
                mensajeEstado += " " + L.T("mensaje.eventosSinSincronizar", string.Join(", ", sinSincronizar));
            }
        }
        finally
        {
            confirmando = false;
        }
    }

    private async Task AlternarCompletada(DateOnly fecha, TareaItem tarea)
    {
        await Storage.ActualizarTareaAsync(fecha, tarea);
    }

    private async Task EliminarTarea(DateOnly fecha, TareaItem tarea)
    {
        if (!string.IsNullOrEmpty(tarea.GoogleEventId) && GoogleCalendar.EstaConectado)
        {
            try { await GoogleCalendar.EliminarEventoAsync(tarea.GoogleEventId); }
            catch { /* si falla la sincronización, igual se borra localmente */ }
        }
        await Storage.EliminarTareaAsync(fecha, tarea.Id);
        semana[fecha] = await Storage.ObtenerTareasAsync(fecha);
    }

    private async Task SincronizarTarea(DateOnly fecha, TareaItem tarea)
    {
        try
        {
            var eventId = await GoogleCalendar.CrearOActualizarEventoAsync(tarea, fecha);
            tarea.GoogleEventId = eventId;
            await Storage.ActualizarTareaAsync(fecha, tarea);
            mensajeEstado = L.T("mensaje.tareaSincronizada", tarea.Texto);
        }
        catch (Exception ex)
        {
            mensajeEstado = L.T("mensaje.errorSincronizar", ex.Message);
        }
    }

    private async Task GuardarEdicion(DateOnly fechaOriginal, EdicionTarea edicion)
    {
        var tarea = semana.TryGetValue(fechaOriginal, out var lista)
            ? lista.FirstOrDefault(t => t.Id == edicion.Id)
            : null;
        if (tarea is null) return;

        tarea.Texto = string.IsNullOrWhiteSpace(edicion.Texto) ? tarea.Texto : edicion.Texto.Trim();
        tarea.Hora = edicion.Hora;
        tarea.Duracion = edicion.DuracionMinutos > 0 ? TimeSpan.FromMinutes(edicion.DuracionMinutos) : null;
        tarea.Fecha = edicion.Fecha;

        await Storage.MoverTareaAsync(fechaOriginal, tarea);

        if (GoogleCalendar.EstaConectado)
        {
            try
            {
                tarea.GoogleEventId = await GoogleCalendar.CrearOActualizarEventoAsync(tarea, tarea.Fecha);
                await Storage.ActualizarTareaAsync(edicion.Fecha, tarea);
            }
            catch (Exception ex)
            {
                mensajeEstado = L.T("mensaje.tareaActualizadaErrorGoogle", ex.Message);
            }
        }

        await CargarSemanaAsync();
    }

    private void ConectarGoogle()
    {
        // El inicio de sesión de Google se hace en este mismo navegador (móvil o PC): se sale de la
        // app a la página de Google y se vuelve a /google/callback, que deja el token guardado.
        conectando = true;
        Navigation.NavigateTo(GoogleCalendarService.RutaConectar, forceLoad: true);
    }

    private async Task DesconectarGoogle()
    {
        await GoogleCalendar.DesconectarAsync();
        mensajeEstado = L.T("mensaje.desconectadoGoogle");
    }

    private async Task SincronizarDesdeGoogle()
    {
        sincronizandoDesdeGoogle = true;
        try
        {
            var eventos = await GoogleCalendar.ObtenerEventosSemanaAsync(semanaActual);

            var tareasPorEventId = semana
                .SelectMany(kv => kv.Value.Select(t => (Fecha: kv.Key, Tarea: t)))
                .Where(x => !string.IsNullOrEmpty(x.Tarea.GoogleEventId))
                .GroupBy(x => x.Tarea.GoogleEventId!)
                .ToDictionary(g => g.Key, g => g.First());

            int nuevas = 0, actualizadas = 0, eliminadas = 0;
            var vistos = new HashSet<string>();

            foreach (var evento in eventos)
            {
                if (string.IsNullOrEmpty(evento.Id)) continue;
                vistos.Add(evento.Id);

                tareasPorEventId.TryGetValue(evento.Id, out var existente);
                switch (await AplicarEventoDeGoogleAsync(evento, existente.Tarea is null ? null : existente))
                {
                    case ResultadoImportacion.Nueva: nuevas++; break;
                    case ResultadoImportacion.Actualizada: actualizadas++; break;
                    case ResultadoImportacion.Eliminada: eliminadas++; break;
                }
            }

            // Tareas de esta semana que estaban en Google y ya no aparecen en ella: o se borraron
            // hace tiempo, o se movieron a otra semana. Se pregunta por cada una para distinguirlo.
            foreach (var (eventId, existente) in tareasPorEventId.Where(kv => !vistos.Contains(kv.Key)))
            {
                var evento = await GoogleCalendar.ObtenerEventoAsync(eventId);
                if (evento is null)
                {
                    await Storage.EliminarTareaAsync(existente.Fecha, existente.Tarea.Id);
                    eliminadas++;
                    continue;
                }

                switch (await AplicarEventoDeGoogleAsync(evento, existente))
                {
                    case ResultadoImportacion.Actualizada: actualizadas++; break;
                    case ResultadoImportacion.Eliminada: eliminadas++; break;
                }
            }

            await CargarSemanaAsync();
            mensajeEstado = L.T("mensaje.importacionCompleta", nuevas, actualizadas, eliminadas);
        }
        catch (Exception ex)
        {
            mensajeEstado = L.T("mensaje.errorImportarGoogle", ex.Message);
        }
        finally
        {
            sincronizandoDesdeGoogle = false;
        }
    }

    private enum ResultadoImportacion { Ninguno, Nueva, Actualizada, Eliminada }

    /// <summary>Lleva un evento de Google a la tarea local que le corresponde (o crea una nueva).</summary>
    private async Task<ResultadoImportacion> AplicarEventoDeGoogleAsync(Google.Apis.Calendar.v3.Data.Event evento, (DateOnly Fecha, TareaItem Tarea)? existente)
    {
        if (evento.Status == "cancelled")
        {
            if (existente is not { } borrada) return ResultadoImportacion.Ninguno;
            await Storage.EliminarTareaAsync(borrada.Fecha, borrada.Tarea.Id);
            return ResultadoImportacion.Eliminada;
        }

        DateOnly fecha;
        TimeOnly? hora;
        if (evento.Start?.DateTimeDateTimeOffset is { } inicio)
        {
            // Pasado a la hora local de este equipo: un evento creado en otra zona horaria debe
            // verse a la hora a la que ocurre aquí, no a la de su zona de origen.
            fecha = DateOnly.FromDateTime(inicio.LocalDateTime);
            hora = TimeOnly.FromDateTime(inicio.LocalDateTime);
        }
        else if (!string.IsNullOrEmpty(evento.Start?.Date) && DateOnly.TryParse(evento.Start.Date, out var fechaSolo))
        {
            fecha = fechaSolo;
            hora = null;
        }
        else
        {
            return ResultadoImportacion.Ninguno;
        }

        var texto = string.IsNullOrWhiteSpace(evento.Summary) ? L.T("tarea.sinTitulo") : evento.Summary;
        TimeSpan? duracion = null;
        if (evento.Start?.DateTimeDateTimeOffset is { } ini && evento.End?.DateTimeDateTimeOffset is { } fin)
        {
            duracion = fin - ini;
        }

        if (existente is { } conocida)
        {
            var tarea = conocida.Tarea;
            tarea.Texto = texto;
            tarea.Hora = hora;
            tarea.Duracion = duracion;
            tarea.Fecha = fecha;
            await Storage.MoverTareaAsync(conocida.Fecha, tarea);
            return ResultadoImportacion.Actualizada;
        }

        await Storage.AgregarTareaAsync(fecha, new TareaItem
        {
            Texto = texto,
            Hora = hora,
            Duracion = duracion,
            Fecha = fecha,
            GoogleEventId = evento.Id
        });
        return ResultadoImportacion.Nueva;
    }

    public void Dispose() => L.OnCambio -= AlCambiarIdioma;
}
