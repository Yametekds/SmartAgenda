@inherits LayoutComponentBase
@inject LocalizationService L
@inject IJSRuntime JS
@implements IDisposable

<div class="app-shell">
    <header class="app-header">
        <div class="app-header-inner">
            <a class="app-brand" href="/" aria-label="Smart Agenda">
                <svg class="app-brand-marca" width="28" height="28" viewBox="0 0 48 48" aria-hidden="true">
                    <g fill="none" stroke-linecap="round" stroke-width="3.25">
                        <rect x="9" y="11.5" width="30" height="27.5" rx="5.5" stroke="currentColor" />
                        <path d="M17 7.5v7M31 7.5v7" stroke="currentColor" />
                        <path d="M15.5 25.25v3.5M20 22.5v9M28 22.5v9M32.5 25.25v3.5" stroke="var(--color-text)" />
                        <path d="M24 19.5v15" stroke="var(--color-primary)" />
                    </g>
                </svg>
                <span>Smart<strong>Agenda</strong></span>
            </a>
            <div class="idioma-toggle" role="group" aria-label="Idioma / Language" data-activo="@(L.Actual == Idioma.Es ? "es" : "en")">
                <span class="idioma-indicador" aria-hidden="true"></span>
                <button type="button" aria-pressed="@(L.Actual == Idioma.Es ? "true" : "false")" @onclick='() => CambiarIdioma(Idioma.Es)'>ES</button>
                <button type="button" aria-pressed="@(L.Actual == Idioma.En ? "true" : "false")" @onclick='() => CambiarIdioma(Idioma.En)'>EN</button>
            </div>
        </div>
    </header>

    <main class="app-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss">&times;</button>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            L.OnCambio += AlCambiarIdioma;
            await L.InicializarAsync(JS);
        }
    }

    private async Task CambiarIdioma(Idioma idioma) => await L.EstablecerAsync(JS, idioma);

    private void AlCambiarIdioma() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.OnCambio -= AlCambiarIdioma;
}
