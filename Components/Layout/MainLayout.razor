@inherits LayoutComponentBase
@inject LocalizationService L
@inject IJSRuntime JS
@implements IDisposable

<div class="app-shell">
    <header class="app-header">
        <div class="app-header-inner">
            <a class="app-brand" href="/" aria-label="Smart Agenda">
                <svg class="app-brand-marca" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="2.5" y="4" width="19" height="17.5" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.75" />
                    <path d="M2.5 9h19M8 2.5v3M16 2.5v3" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
                    <rect x="13.5" y="12.5" width="4.5" height="4.5" rx="1" fill="var(--color-primary)" />
                </svg>
                <span>Smart<strong>Agenda</strong></span>
            </a>
            <div class="idioma-toggle" role="group" aria-label="Idioma / Language" data-activo="@(L.Actual == Idioma.Es ? "es" : "en")">
                <span class="idioma-indicador" aria-hidden="true"></span>
                <button type="button" aria-pressed="@(L.Actual == Idioma.Es ? "true" : "false")" @onclick='() => CambiarIdioma(Idioma.Es)'>ES</button>
                <button type="button" aria-pressed="@(L.Actual == Idioma.En ? "true" : "false")" @onclick='() => CambiarIdioma(Idioma.En)'>EN</button>
            </div>
        </div>
    </header>

    <main class="app-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss">&times;</button>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            L.OnCambio += AlCambiarIdioma;
            await L.InicializarAsync(JS);
        }
    }

    private async Task CambiarIdioma(Idioma idioma) => await L.EstablecerAsync(JS, idioma);

    private void AlCambiarIdioma() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.OnCambio -= AlCambiarIdioma;
}
