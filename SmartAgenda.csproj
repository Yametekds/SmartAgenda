<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- La librería compartida y los tests tienen su propio .csproj: que no se compilen también aquí. -->
  <ItemGroup>
    <Compile Remove="tests\**;SmartAgenda.Core\**;SmartAgenda.Movil\**" />
    <Content Remove="tests\**;SmartAgenda.Core\**;SmartAgenda.Movil\**" />
    <None Remove="tests\**;SmartAgenda.Core\**;SmartAgenda.Movil\**" />
    <EmbeddedResource Remove="tests\**;SmartAgenda.Core\**;SmartAgenda.Movil\**" />
  </ItemGroup>

  <!-- Componentes, servicios y modelos compartidos con la app Android. -->
  <ItemGroup>
    <ProjectReference Include="SmartAgenda.Core\SmartAgenda.Core.csproj" />
  </ItemGroup>

</Project>
