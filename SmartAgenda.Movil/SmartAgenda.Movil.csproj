<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    App Android: los mismos componentes y servicios que la web (SmartAgenda.Core), ejecutados
    dentro de la propia app con .NET MAUI Blazor Hybrid. Sin servidor, sin Tailscale y sin
    contraseña: los datos viven en la carpeta privada de la app y se sincronizan con Google Calendar.
  -->
  <PropertyGroup>
    <TargetFrameworks>net9.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>SmartAgenda.Movil</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <ApplicationTitle>Smart Agenda</ApplicationTitle>
    <ApplicationId>com.yametekds.smartagenda</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Un APK que se instala directamente en el móvil, sin pasar por Google Play. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidLinkMode>None</AndroidLinkMode>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>

  <!-- Firma de las versiones publicadas: la clave llega desde los secretos del repositorio (ver README). -->
  <PropertyGroup Condition="'$(AndroidKeyStorePath)' != ''">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(AndroidKeyStorePath)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>$(AndroidKeyAlias)</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>env:ANDROID_KEY_PASSWORD</AndroidSigningKeyPass>
    <AndroidSigningStorePass>env:ANDROID_KEYSTORE_PASSWORD</AndroidSigningStorePass>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#12181C" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#12181C" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartAgenda.Core\SmartAgenda.Core.csproj" />
  </ItemGroup>

</Project>
